# ---------------------------------------------------------------
# Copy to .env and fill in. Nothing here is invented or defaulted
# to a fake value: if a key is missing, the matching feature reports
# itself as unavailable in the UI rather than pretending to work.
# ---------------------------------------------------------------

# --- ClickHouse (behavioural event stream) -----------------------
# Required for analytics, pattern detection and adaptation.
# Without it, events are queued to .data/event-queue.jsonl and replayed
# automatically once these are filled in.
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_SECURE=true
CLICKHOUSE_DATABASE=storybook

# --- LLM (book -> playable story generation) ---------------------
# Without this, the "Make it playable" button is disabled with an
# explicit "LLM not configured" message. It never fakes a story.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Relational store --------------------------------------------
# Optional. Set to a Postgres connection string to use Postgres.
# If empty, an embedded SQLite file at .data/storybook.db is used.
DATABASE_URL=

PORT=8787
